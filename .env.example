# Generate actual secrets with: python3 scripts/configure.py --host map.example.com
DJANGO_SECRET_KEY=REPLACE_WITH_GENERATED_SECRET
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,map.example.com
POSTGRES_DB=derry
POSTGRES_USER=derry
POSTGRES_PASSWORD=REPLACE_WITH_GENERATED_PASSWORD
DERRY_BIND=127.0.0.1
DERRY_PORT=8080
# Set TRUST_PROXY=1 only behind your trusted TLS reverse proxy.
DJANGO_TRUST_PROXY=0
DJANGO_SSL_REDIRECT=0
